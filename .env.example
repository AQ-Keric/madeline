# Copia este archivo a .env y completa los valores.

# Groq (LLM + Whisper): https://console.groq.com/keys
GROQ_API_KEY=

# Telegram (opcional): para mandarte las capturas de pantalla
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Token que debe mandar la app del celular (header X-Madeline-Token).
# Si se deja vacío, el servidor queda abierto a toda la red local.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
MADELINE_TOKEN=

# Voz de edge-tts (edge-tts --list-voices | grep es-)
MADELINE_VOZ=es-MX-DaliaNeural

# Efecto de voz: sutil | holografico | ninguno
MADELINE_EFECTO_VOZ=ninguno

# Voz local de respaldo (opcional): ruta a un modelo .onnx de Piper
MADELINE_PIPER_MODELO=

# Memoria a largo plazo (necesita: ollama pull embeddinggemma)
MADELINE_MODELO_EMBED=embeddinggemma
# Tiempo que el modelo de embeddings queda en RAM (~700 MB) tras usarse
MADELINE_EMBED_KEEP_ALIVE=10m
